{
  "name": "getmyjob",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node engines/node/start-tunnel.cjs & NODE_OPTIONS='--max-old-space-size=6144' next dev",
    "dev:tunnel": "node engines/node/start-tunnel.cjs",
    "engine": "npx tsx engines/node/cli.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:python": "python3 -m pytest engines/python/discovery/tests -q && python3 -m pytest engines/python/unified_engine/tests -q",
    "localstack:up": "docker-compose up dynamodb-local dynamodb-init -d && echo '⏳ Waiting for tables...' && sleep 8 && echo '✅ DynamoDB Local ready'",
    "localstack:down": "docker-compose stop dynamodb-local",
    "localstack:reset": "docker-compose down dynamodb-local -v && npm run localstack:up",
    "dev:localstack": "BACKEND_METHOD=localstack npm run dev",
    "localstack:tables": "aws --endpoint-url=http://localhost:4566 dynamodb list-tables --region us-east-1",
    "test:localstack": "BACKEND_METHOD=localstack node tests/localstack-adapter.test.mjs",
    "graphify:full": "ANTHROPIC_API_KEY=sk-3474d6547f654fe2-a9a2c5-8aad41df ANTHROPIC_BASE_URL=http://localhost:20128/v1 /Users/apple/Library/Python/3.14/bin/graphify . --mode deep",
    "graphify:watch": "ANTHROPIC_API_KEY=sk-3474d6547f654fe2-a9a2c5-8aad41df ANTHROPIC_BASE_URL=http://localhost:20128/v1 /Users/apple/Library/Python/3.14/bin/graphify . --watch",
    "graphify:wiki": "ANTHROPIC_API_KEY=sk-3474d6547f654fe2-a9a2c5-8aad41df ANTHROPIC_BASE_URL=http://localhost:20128/v1 /Users/apple/Library/Python/3.14/bin/graphify . --wiki"
  },
  "dependencies": {
    "@gradio/client": "^2.3.1",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "ghost-cursor": "^1.4.2",
    "isomorphic-dompurify": "^3.18.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "19.2.17",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "ngrok": "^5.0.0-beta.2",
    "tsx": "^4.23.1"
  }
}